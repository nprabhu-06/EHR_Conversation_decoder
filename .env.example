# ── Clinical Conversation Intelligence — Environment Variables ────────────────
# Copy to .env and fill in your values.
# NEVER commit .env to version control (it contains API keys and credentials).
# ─────────────────────────────────────────────────────────────────────────────

# ── Engine selection ──────────────────────────────────────────────────────────
# Default engine when --engine flag is omitted.
# Options: assemblyai | community-whisperx | sortformer-whisper
DEFAULT_ENGINE=assemblyai

# ── ASR model ─────────────────────────────────────────────────────────────────
# Whisper model size. Larger = more accurate but slower.
# Options: tiny | base | small | medium | large-v3
# For CPU-only systems, use: medium (large-v3 is very slow on CPU)
WHISPER_MODEL=large-v3

# ── API credentials ───────────────────────────────────────────────────────────
# AssemblyAI API key (required for --engine assemblyai)
# Get yours at: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=

# HuggingFace access token (required for --engine community-whisperx)
# Get yours at: https://huggingface.co/settings/tokens
# Also accept model terms at: https://huggingface.co/pyannote/speaker-diarization
HUGGINGFACE_TOKEN=

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=output

# ── Consent ───────────────────────────────────────────────────────────────────
# Set to true if consent is managed at system/intake level.
# If false, --consent flag is required on every CLI run.
CONSENT_LOGGED=false

# ── Speaker role mapping ──────────────────────────────────────────────────────
# Options: first_speaker | manual | interactive
SPEAKER_MAPPING_STRATEGY=first_speaker

# ── Audio preprocessing ───────────────────────────────────────────────────────
ENABLE_VAD=true
ENABLE_NOISE_REDUCTION=false
ENABLE_ECHO_CANCELLATION=false

# ── Pipeline toggles ──────────────────────────────────────────────────────────
ENABLE_OVERLAP_DETECTION=true
ENABLE_LANGUAGE_DETECTION=true
ENABLE_MEDICAL_NORMALIZATION=true
ENABLE_CLINICAL_SUMMARY=true

# ── Confidence thresholds ─────────────────────────────────────────────────────
HIGH_CONFIDENCE_THRESHOLD=0.90
LOW_CONFIDENCE_THRESHOLD=0.70
CONFIDENCE_THRESHOLD=0.75
